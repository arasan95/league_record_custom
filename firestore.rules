rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isDatabaseAdmin() {
      return isGoogleUser()
        && exists(/databases/$(database)/documents/appAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/appAdmins/$(request.auth.uid)).data.role == 'admin';
    }

    function hasActiveModeration(uid) {
      let path = /databases/$(database)/documents/communityModeration/$(uid);
      let moderation = get(path).data;
      return exists(path)
        && (
          moderation.expiresAt == null
          || moderation.expiresAt > request.time
        );
    }

    function isCurrentUserBanned() {
      let path = /databases/$(database)/documents/communityModeration/$(request.auth.uid);
      let moderation = get(path).data;
      return exists(path)
        && (moderation.expiresAt == null || moderation.expiresAt > request.time)
        && moderation.action == 'ban';
    }

    function hasValidModeration(data, uid) {
      return data.keys().hasAll(['uid', 'action', 'expiresAt', 'reason', 'adminUid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'action', 'expiresAt', 'reason', 'adminUid', 'updatedAt'])
        && data.uid == uid
        && (data.action == 'comment_block' || data.action == 'ban')
        && (data.expiresAt == null || (data.expiresAt is timestamp && data.expiresAt > request.time))
        && data.reason is string
        && data.reason.size() > 0
        && data.reason.size() <= 280
        && data.adminUid == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /appAdmins/{uid} {
      allow get: if isGoogleUser() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /communityModeration/{uid} {
      allow get: if isGoogleUser() && (request.auth.uid == uid || isDatabaseAdmin());
      allow list: if isDatabaseAdmin();
      allow create, update: if isDatabaseAdmin() && hasValidModeration(request.resource.data, uid);
      allow delete: if isDatabaseAdmin();
    }

    match /commentReports/{reportId} {
      function reportedCommentPath() {
        return /databases/$(database)/documents/replays/$(request.resource.data.videoId)/comments/$(request.resource.data.commentId);
      }

      function hasValidReport(data) {
        return data.keys().hasAll([
            'reporterUid', 'videoId', 'commentId', 'authorName', 'authorPublicId',
            'commentText', 'details', 'status', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'reporterUid', 'videoId', 'commentId', 'authorName', 'authorPublicId',
            'commentText', 'details', 'status', 'createdAt', 'updatedAt'
          ])
          && data.reporterUid == request.auth.uid
          && reportId == data.videoId + '_' + data.commentId + '_' + request.auth.uid
          && data.videoId is string
          && data.videoId.matches('^[A-Za-z0-9_-]{11}$')
          && data.commentId is string
          && data.commentId.matches('^[A-Za-z0-9_-]{8,80}$')
          && data.authorName is string
          && data.authorName.size() > 0
          && data.authorName.size() <= 64
          && (data.authorPublicId == null
            || (data.authorPublicId is string && data.authorPublicId.matches('^[A-Za-z0-9]{10}$')))
          && data.commentText is string
          && data.commentText.size() > 0
          && data.commentText.size() <= 280
          && data.details is string
          && data.details.size() <= 200
          && data.status == 'pending'
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && exists(reportedCommentPath())
          && get(reportedCommentPath()).data.status == 'published'
          && get(reportedCommentPath()).data.authorName == data.authorName
          && get(reportedCommentPath()).data.authorPublicId == data.authorPublicId
          && get(reportedCommentPath()).data.text == data.commentText;
      }

      allow get: if isGoogleUser()
        && (resource == null || resource.data.reporterUid == request.auth.uid || isDatabaseAdmin());
      allow list: if isDatabaseAdmin();
      allow create: if isGoogleUser()
        && !hasActiveModeration(request.auth.uid)
        && hasValidReport(request.resource.data);
      allow update: if isDatabaseAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'resolved'
        && request.resource.data.resolvedByUid == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedByUid', 'resolvedAt', 'updatedAt']);
      allow delete: if false;
    }

    function quotaPath(uid) {
      return /databases/$(database)/documents/writeQuotas/$(uid);
    }

    function hasValidQuotaFields(data, uid) {
      return data.keys().hasAll([
          'ownerUid',
          'lastReplayId',
          'windowStartedAt',
          'lastWriteAt',
          'updatedAt',
          'writeCount',
          'createCount'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'lastReplayId',
          'windowStartedAt',
          'lastWriteAt',
          'updatedAt',
          'writeCount',
          'createCount'
        ])
        && data.ownerUid == uid
        && data.lastReplayId is string
        && data.lastReplayId.matches('^[A-Za-z0-9_-]{11}$')
        && data.windowStartedAt is timestamp
        && data.lastWriteAt is timestamp
        && data.updatedAt is timestamp
        && data.writeCount is int
        && data.writeCount > 0
        && data.writeCount <= 50
        && data.createCount is int
        && data.createCount >= 0
        && data.createCount <= 20
        && data.createCount <= data.writeCount;
    }

    function isInitialQuota(after, uid, isCreate) {
      return !exists(quotaPath(uid))
        && hasValidQuotaFields(after, uid)
        && after.windowStartedAt == request.time
        && after.lastWriteAt == request.time
        && after.updatedAt == request.time
        && after.writeCount == 1
        && after.createCount == (isCreate ? 1 : 0);
    }

    function isContinuedQuota(before, after, uid, isCreate) {
      return exists(quotaPath(uid))
        && hasValidQuotaFields(after, uid)
        && after.lastWriteAt == request.time
        && after.updatedAt == request.time
        && (
          (request.time >= before.windowStartedAt + duration.value(24, 'h')
            && after.windowStartedAt == request.time
            && after.writeCount == 1
            && after.createCount == (isCreate ? 1 : 0))
          ||
          (request.time < before.windowStartedAt + duration.value(24, 'h')
            && request.time >= before.lastWriteAt + duration.value(10, 's')
            && after.windowStartedAt == before.windowStartedAt
            && after.writeCount == before.writeCount + 1
            && after.createCount == before.createCount + (isCreate ? 1 : 0))
        );
    }

    function consumesReplayQuota(isCreate, videoId) {
      let path = quotaPath(request.auth.uid);
      let after = getAfter(path).data;
      return after.lastReplayId == videoId
        && (isInitialQuota(after, request.auth.uid, isCreate)
          || isContinuedQuota(get(path).data, after, request.auth.uid, isCreate));
    }

    match /writeQuotas/{uid} {
      allow get: if isGoogleUser() && uid == request.auth.uid;
      allow list: if false;
      allow create: if isGoogleUser()
        && uid == request.auth.uid
        && hasValidQuotaFields(request.resource.data, uid)
        && request.resource.data.windowStartedAt == request.time
        && request.resource.data.lastWriteAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.writeCount == 1
        && (request.resource.data.createCount == 0 || request.resource.data.createCount == 1);
      allow update: if isGoogleUser()
        && uid == request.auth.uid
        && resource.data.ownerUid == uid
        && hasValidQuotaFields(request.resource.data, uid)
        && request.resource.data.lastWriteAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (request.time >= resource.data.windowStartedAt + duration.value(24, 'h')
            && request.resource.data.windowStartedAt == request.time
            && request.resource.data.writeCount == 1
            && (request.resource.data.createCount == 0 || request.resource.data.createCount == 1))
          ||
          (request.time < resource.data.windowStartedAt + duration.value(24, 'h')
            && request.time >= resource.data.lastWriteAt + duration.value(10, 's')
            && request.resource.data.windowStartedAt == resource.data.windowStartedAt
            && request.resource.data.writeCount == resource.data.writeCount + 1
            && (request.resource.data.createCount == resource.data.createCount
              || request.resource.data.createCount == resource.data.createCount + 1))
        );
      allow delete: if false;
    }

    function commentQuotaPath(uid, videoId) {
      return /databases/$(database)/documents/commentWriteQuotas/$(uid + '_' + videoId);
    }

    function hasValidCommentQuota(data, uid, videoId) {
      return data.keys().hasAll(['uid', 'videoId', 'lastCommentId', 'windowStartedAt', 'lastWriteAt', 'writeCount'])
        && data.keys().hasOnly(['uid', 'videoId', 'lastCommentId', 'windowStartedAt', 'lastWriteAt', 'writeCount'])
        && data.uid == uid
        && data.videoId == videoId
        && data.lastCommentId is string
        && data.lastCommentId.matches('^[A-Za-z0-9_-]{8,80}$')
        && data.windowStartedAt is timestamp
        && data.lastWriteAt is timestamp
        && data.writeCount is int
        && data.writeCount > 0
        && data.writeCount <= 200;
    }

    function isInitialCommentQuota(after, uid, videoId, commentId) {
      return !exists(commentQuotaPath(uid, videoId))
        && hasValidCommentQuota(after, uid, videoId)
        && after.lastCommentId == commentId
        && after.windowStartedAt == request.time
        && after.lastWriteAt == request.time
        && after.writeCount == 1;
    }

    function isContinuedCommentQuota(before, after, uid, videoId, commentId) {
      return exists(commentQuotaPath(uid, videoId))
        && hasValidCommentQuota(after, uid, videoId)
        && after.lastCommentId == commentId
        && after.lastWriteAt == request.time
        && (
          (request.time >= before.windowStartedAt + duration.value(24, 'h')
            && after.windowStartedAt == request.time
            && after.writeCount == 1)
          ||
          (request.time < before.windowStartedAt + duration.value(24, 'h')
            && request.time >= before.lastWriteAt + duration.value(2, 's')
            && after.windowStartedAt == before.windowStartedAt
            && after.writeCount == before.writeCount + 1)
        );
    }

    function consumesCommentQuota(uid, videoId, commentId) {
      let path = commentQuotaPath(uid, videoId);
      let after = getAfter(path).data;
      return isInitialCommentQuota(after, uid, videoId, commentId)
        || isContinuedCommentQuota(get(path).data, after, uid, videoId, commentId);
    }

    match /commentWriteQuotas/{quotaId} {
      allow get: if isGoogleUser() && (resource == null || resource.data.uid == request.auth.uid);
      allow list, delete: if false;
      allow create, update: if isGoogleUser()
        && quotaId == request.auth.uid + '_' + request.resource.data.videoId
        && hasValidCommentQuota(request.resource.data, request.auth.uid, request.resource.data.videoId)
        && request.resource.data.lastWriteAt == request.time;
    }

    function hasValidCommunityProfile(data, uid) {
      return data.keys().hasAll(['uid', 'publicId', 'accountName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'publicId', 'accountName', 'riotAccount', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.publicId is string
        && data.publicId.matches('^[A-Za-z0-9]{10}$')
        && (data.accountName == null || (data.accountName is string
          && data.accountName.size() > 0 && data.accountName.size() <= 32))
        && (data.get('riotAccount', null) == null || (
          data.riotAccount is map
          && data.riotAccount.keys().hasAll([
            'puuid', 'gameName', 'tagLine', 'platformId', 'soloRank', 'flexRank', 'primaryRank', 'verifiedAt'
          ])
          && data.riotAccount.keys().hasOnly([
            'puuid', 'gameName', 'tagLine', 'platformId', 'soloRank', 'flexRank', 'primaryRank', 'verifiedAt'
          ])
          && data.riotAccount.puuid is string
          && data.riotAccount.puuid.matches('^[A-Za-z0-9_-]{20,128}$')
          && data.riotAccount.gameName is string
          && data.riotAccount.gameName.size() > 0 && data.riotAccount.gameName.size() <= 32
          && data.riotAccount.tagLine is string && data.riotAccount.tagLine.size() <= 16
          && data.riotAccount.platformId is string
          && data.riotAccount.platformId.matches('^[A-Z0-9]{2,12}$')
          && data.riotAccount.soloRank is string && data.riotAccount.soloRank.size() > 0 && data.riotAccount.soloRank.size() <= 32
          && data.riotAccount.flexRank is string && data.riotAccount.flexRank.size() > 0 && data.riotAccount.flexRank.size() <= 32
          && data.riotAccount.primaryRank is string && data.riotAccount.primaryRank.size() > 0 && data.riotAccount.primaryRank.size() <= 32
          && data.riotAccount.verifiedAt is timestamp
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /communityProfiles/{uid} {
      allow get: if isGoogleUser() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create: if isGoogleUser()
        && request.auth.uid == uid
        && hasValidCommunityProfile(request.resource.data, uid)
        && request.resource.data.accountName == null
        && request.resource.data.get('riotAccount', null) == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/communityPublicIds/$(request.resource.data.publicId))
        && getAfter(/databases/$(database)/documents/communityPublicIds/$(request.resource.data.publicId)).data.uid == uid;
      allow update: if isGoogleUser()
        && request.auth.uid == uid
        && hasValidCommunityProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountName', 'riotAccount', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['riotAccount'])
          || request.resource.data.riotAccount == null
          || request.resource.data.riotAccount.verifiedAt == request.time);
    }

    match /communityPublicIds/{publicId} {
      allow get, list, update, delete: if false;
      allow create: if isGoogleUser()
        && publicId.matches('^[A-Za-z0-9]{10}$')
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.publicId == publicId;
    }

    match /replays/{videoId} {

      function hasValidFields(data) {
        return data.keys().hasAll([
            'format',
            'schemaVersion',
            'status',
            'provider',
            'youtubeVideoId',
            'ownerUid',
            'payloadJson',
            'payloadBytes',
            'payloadSha256',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'format',
            'schemaVersion',
            'status',
            'provider',
            'youtubeVideoId',
            'ownerUid',
            'payloadJson',
            'payloadBytes',
            'payloadSha256',
            'createdAt',
            'updatedAt'
          ]);
      }

      function isValidReplay(data) {
        return hasValidFields(data)
          && data.format == 'league-record-share'
          && data.schemaVersion == 1
          && data.status == 'published'
          && data.provider == 'youtube'
          && data.youtubeVideoId == videoId
          && videoId.matches('^[A-Za-z0-9_-]{11}$')
          && data.ownerUid is string
          && data.ownerUid.size() > 0
          && data.ownerUid.size() <= 128
          && data.payloadJson is string
          && data.payloadJson.size() > 0
          && data.payloadJson.size() <= 196608
          && data.payloadBytes is int
          && data.payloadBytes > 0
          && data.payloadBytes <= 196608
          && data.payloadSha256 is string
          && data.payloadSha256.matches('^[0-9a-f]{64}$')
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      // A viewer may open one known published replay. Authenticated owners may
      // query only their own replay documents (the query must filter ownerUid).
      allow get: if videoId.matches('^[A-Za-z0-9_-]{11}$')
        && (resource == null || isValidReplay(resource.data));
      allow list: if isGoogleUser()
        && resource.data.ownerUid == request.auth.uid
        && request.query.limit != null
        && request.query.limit <= 100;
      allow create: if isGoogleUser()
        && request.resource.data.ownerUid == request.auth.uid
        && consumesReplayQuota(true, videoId)
        && isValidReplay(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isGoogleUser()
        && resource.data.ownerUid == request.auth.uid
        && consumesReplayQuota(false, videoId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'payloadJson',
          'payloadBytes',
          'payloadSha256',
          'updatedAt'
        ])
        && isValidReplay(request.resource.data);
      allow delete: if isGoogleUser() && resource.data.ownerUid == request.auth.uid;

      function replayOwnerUid() {
        return get(/databases/$(database)/documents/replays/$(videoId)).data.ownerUid;
      }

      function isReplayCommentOwner() {
        return isGoogleUser() && request.auth.uid == replayOwnerUid();
      }

      function isActiveCommentMember() {
        return isGoogleUser()
          && exists(/databases/$(database)/documents/replays/$(videoId)/commentMembers/$(request.auth.uid))
          && get(/databases/$(database)/documents/replays/$(videoId)/commentMembers/$(request.auth.uid)).data.status == 'active';
      }

      function hasRankVerifiedProfile() {
        return isGoogleUser()
          && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.get('riotAccount', null) is map;
      }

      function currentProfileRank() {
        let profile = get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data;
        return profile.get('riotAccount', null) is map ? profile.riotAccount.primaryRank : null;
      }

      function hasPublicCommentAccess() {
        return !exists(/databases/$(database)/documents/replays/$(videoId)/commentSettings/access)
          || get(/databases/$(database)/documents/replays/$(videoId)/commentSettings/access).data.readAccess == 'public'
          || isReplayCommentOwner()
          || isActiveCommentMember();
      }

      function canReadPublicComments() {
        return hasPublicCommentAccess()
          && (!isGoogleUser() || !isCurrentUserBanned());
      }

      function canWriteCommunityComments() {
        return !hasActiveModeration(request.auth.uid)
          && hasPublicCommentAccess()
          && (
            isReplayCommentOwner()
            || ((!exists(/databases/$(database)/documents/replays/$(videoId)/commentSettings/access)
                || get(/databases/$(database)/documents/replays/$(videoId)/commentSettings/access).data.writeAccess == 'invite_only')
              && isActiveCommentMember())
            || (exists(/databases/$(database)/documents/replays/$(videoId)/commentSettings/access)
              && get(/databases/$(database)/documents/replays/$(videoId)/commentSettings/access).data.writeAccess == 'public')
            || (exists(/databases/$(database)/documents/replays/$(videoId)/commentSettings/access)
              && get(/databases/$(database)/documents/replays/$(videoId)/commentSettings/access).data.writeAccess == 'rank_verified'
              && hasRankVerifiedProfile())
          );
      }

      function hasValidSettings(data) {
        return data.keys().hasAll(['ownerUid', 'writeAccess', 'readAccess', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['ownerUid', 'writeAccess', 'readAccess', 'createdAt', 'updatedAt'])
          && data.ownerUid == replayOwnerUid()
          && (data.writeAccess == 'public' || data.writeAccess == 'invite_only' || data.writeAccess == 'rank_verified')
          && (data.readAccess == 'public' || data.readAccess == 'invite_only')
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      match /commentSettings/{settingsId} {
        allow get: if settingsId == 'access';
        allow list, delete: if false;
        allow create: if settingsId == 'access'
          && isReplayCommentOwner()
          && hasValidSettings(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if settingsId == 'access'
          && isReplayCommentOwner()
          && hasValidSettings(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['writeAccess', 'readAccess', 'updatedAt']);
      }

      match /commentMembers/{uid} {
        allow get: if isGoogleUser() && (request.auth.uid == uid || isReplayCommentOwner());
        allow list: if isReplayCommentOwner();
        allow create: if isGoogleUser()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll([
            'uid', 'role', 'status', 'displayName', 'groupIds', 'invitedByUid', 'grantedAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'role', 'status', 'displayName', 'groupIds', 'invitedByUid', 'grantedAt', 'updatedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.role == 'commenter'
          && request.resource.data.status == 'active'
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 64
          && request.resource.data.groupIds is list
          && request.resource.data.groupIds.size() == 1
          && request.resource.data.groupIds[0] is string
          && request.resource.data.groupIds[0].matches('^[0-9a-f]{48}$')
          && request.resource.data.grantedAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/replays/$(videoId)/commentInvites/$(request.resource.data.groupIds[0]))
          && get(/databases/$(database)/documents/replays/$(videoId)/commentInvites/$(request.resource.data.groupIds[0])).data.createdByUid == request.resource.data.invitedByUid
          && getAfter(/databases/$(database)/documents/replays/$(videoId)/commentInvites/$(request.resource.data.groupIds[0])).data.usedCount
            == get(/databases/$(database)/documents/replays/$(videoId)/commentInvites/$(request.resource.data.groupIds[0])).data.usedCount + 1;
        allow update, delete: if false;
      }

      match /commentInvites/{inviteId} {
        allow get: if isGoogleUser();
        allow list, delete: if false;
        allow create: if isReplayCommentOwner()
          && inviteId.matches('^[0-9a-f]{48}$')
          && request.resource.data.keys().hasAll([
            'status', 'role', 'createdByUid', 'createdAt', 'expiresAt', 'maxUses', 'usedCount'
          ])
          && request.resource.data.keys().hasOnly([
            'status', 'role', 'createdByUid', 'createdAt', 'expiresAt', 'maxUses', 'usedCount'
          ])
          && request.resource.data.status == 'active'
          && request.resource.data.role == 'commenter'
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time + duration.value(23, 'h')
          && request.resource.data.expiresAt < request.time + duration.value(25, 'h')
          && request.resource.data.maxUses == 1
          && request.resource.data.usedCount == 0;
        allow update: if isGoogleUser()
          && inviteId.matches('^[0-9a-f]{48}$')
          && resource.data.status == 'active'
          && resource.data.role == 'commenter'
          && resource.data.expiresAt > request.time
          && resource.data.usedCount < resource.data.maxUses
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedCount', 'usedAt'])
          && request.resource.data.status == 'used'
          && request.resource.data.usedCount == resource.data.usedCount + 1
          && request.resource.data.usedCount == resource.data.maxUses
          && request.resource.data.usedAt == request.time
          && existsAfter(/databases/$(database)/documents/replays/$(videoId)/commentMembers/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/replays/$(videoId)/commentMembers/$(request.auth.uid)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/replays/$(videoId)/commentMembers/$(request.auth.uid)).data.groupIds[0] == inviteId;
      }

      function hasValidComment(data, commentId) {
        return data.keys().hasAll([
            'schemaVersion', 'text', 'videoTimeMs', 'rating', 'color', 'size', 'durationMs',
            'mode', 'x', 'y', 'visibility', 'clientRequestId', 'authorName', 'authorPublicId',
            'authorGroupIds', 'status', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'schemaVersion', 'text', 'videoTimeMs', 'rating', 'color', 'size', 'durationMs',
            'mode', 'x', 'y', 'visibility', 'clientRequestId', 'authorUid', 'authorName',
            'authorPublicId', 'authorGroupIds', 'authorRank', 'anonymous', 'status', 'createdAt', 'updatedAt'
          ])
          && data.schemaVersion == 1
          && data.text is string
          && data.text.size() > 0
          && data.text.size() <= 280
          && data.videoTimeMs is int
          && data.videoTimeMs >= 0
          && data.videoTimeMs <= 86400000
          && (data.rating == null || data.rating == 'good' || data.rating == 'bad' || data.rating == 'question')
          && data.color is string
          && data.color.matches('^#[0-9a-fA-F]{6}$')
          && (data.size == 'small' || data.size == 'medium' || data.size == 'large')
          && data.durationMs is int
          && data.durationMs >= 1000
          && data.durationMs <= 30000
          && (data.mode == 'scroll' || data.mode == 'fixed')
          && ((data.mode == 'scroll' && data.x == null && data.y == null)
            || (data.mode == 'fixed' && data.x is int && data.x >= 0 && data.x <= 10000
              && data.y is int && data.y >= 0 && data.y <= 10000))
          && (data.visibility == 'public' || data.visibility == 'private')
          && (!data.keys().hasAny(['anonymous']) || data.anonymous is bool)
          && (data.get('anonymous', false) == false || data.visibility == 'public')
          && data.clientRequestId == commentId
          && commentId.matches('^[A-Za-z0-9_-]{8,80}$')
          && (!data.keys().hasAny(['authorUid']) || data.authorUid is string)
          && data.authorName is string
          && data.authorName.size() > 0
          && data.authorName.size() <= 64
          && (data.authorPublicId == null || (data.authorPublicId is string
            && data.authorPublicId.matches('^[A-Za-z0-9]{10}$')))
          && data.authorGroupIds is list
          && data.authorGroupIds.size() <= 20
          && data.authorGroupIds == (data.get('anonymous', false) == true
            ? []
            : (isActiveCommentMember()
              ? get(/databases/$(database)/documents/replays/$(videoId)/commentMembers/$(request.auth.uid)).data.groupIds
              : []))
          && (!data.keys().hasAny(['authorRank']) || data.authorRank == null
            || (data.authorRank is string && data.authorRank.size() > 0 && data.authorRank.size() <= 32))
          && data.status == 'published'
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function commentAuthorPath(commentId) {
        return /databases/$(database)/documents/replays/$(videoId)/commentAuthors/$(commentId);
      }

      function commentPath(commentId) {
        return /databases/$(database)/documents/replays/$(videoId)/comments/$(commentId);
      }

      function isSeparatedCommentAuthor(commentId) {
        return isGoogleUser()
          && exists(commentAuthorPath(commentId))
          && get(commentAuthorPath(commentId)).data.uid == request.auth.uid;
      }

      function isLegacyCommentAuthor(data) {
        return isGoogleUser()
          && data.keys().hasAny(['authorUid'])
          && data.authorUid == request.auth.uid;
      }

      function isCommentAuthor(commentId, data) {
        return isSeparatedCommentAuthor(commentId) || isLegacyCommentAuthor(data);
      }

      function isPrivateCommentReader(data) {
        return isGoogleUser()
          && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
          && data.authorPublicId
            == get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.publicId;
      }

      function hasValidCommentAuthor(data) {
        return data.keys().hasAll(['uid', 'publicId', 'createdAt'])
          && data.keys().hasOnly(['uid', 'publicId', 'createdAt'])
          && data.uid is string
          && data.publicId is string
          && data.publicId.matches('^[A-Za-z0-9]{10}$')
          && data.createdAt is timestamp;
      }

      match /commentAuthors/{commentId} {
        // A signed-in author may read only their own ownership records so the
        // UI can retain edit/delete controls for anonymous comments. Other
        // clients cannot use this collection to identify an anonymous author.
        allow get, list: if isGoogleUser()
          && (resource.data.uid == request.auth.uid || isDatabaseAdmin());
        allow update, delete: if false;
        allow create: if isGoogleUser()
          && hasValidCommentAuthor(request.resource.data)
          && existsAfter(commentPath(commentId))
          && (getAfter(commentPath(commentId)).data.get('anonymous', false) == true
            || getAfter(commentPath(commentId)).data.authorPublicId == request.resource.data.publicId)
          && !getAfter(commentPath(commentId)).data.keys().hasAny(['authorUid'])
          && (
            (request.resource.data.uid == request.auth.uid
              && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
              && request.resource.data.publicId
                == get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.publicId
              && request.resource.data.createdAt == request.time)
            ||
            (exists(commentPath(commentId))
              && get(commentPath(commentId)).data.keys().hasAny(['authorUid'])
              && get(commentPath(commentId)).data.authorUid == request.resource.data.uid
              && get(commentPath(commentId)).data.authorPublicId == request.resource.data.publicId
              && get(commentPath(commentId)).data.createdAt == request.resource.data.createdAt
              && (request.auth.uid == request.resource.data.uid || isReplayCommentOwner()))
          );
      }

      match /comments/{commentId} {
        allow get: if (resource == null && isGoogleUser()) || (resource != null
          && exists(/databases/$(database)/documents/replays/$(videoId))
          && resource.data.status == 'published'
          && (
            (resource.data.visibility == 'public' && canReadPublicComments())
            || (resource.data.visibility == 'private' && isPrivateCommentReader(resource.data))
          ));
        allow list: if exists(/databases/$(database)/documents/replays/$(videoId))
          && resource.data.status == 'published'
          && (
            (resource.data.visibility == 'public' && canReadPublicComments())
            || (resource.data.visibility == 'private' && isPrivateCommentReader(resource.data))
          );
        allow create: if isGoogleUser()
          && canWriteCommunityComments()
          && hasValidComment(request.resource.data, commentId)
          && request.resource.data.anonymous is bool
          && !request.resource.data.keys().hasAny(['authorUid'])
          && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
          && (
            (request.resource.data.anonymous == true
              && request.resource.data.visibility == 'public'
              && request.resource.data.authorName == 'Anonymous'
              && request.resource.data.authorPublicId == null
              && request.resource.data.authorGroupIds == []
              && request.resource.data.get('authorRank', null) == null)
            ||
            (request.resource.data.anonymous == false
              && request.resource.data.authorPublicId
                == get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.publicId
              && request.resource.data.authorName
                == (get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.accountName is string
                  ? get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.accountName
                  : get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.publicId)
              && request.resource.data.get('authorRank', null) == currentProfileRank())
          )
          && existsAfter(commentAuthorPath(commentId))
          && getAfter(commentAuthorPath(commentId)).data.uid == request.auth.uid
          && (request.resource.data.anonymous == true
            || getAfter(commentAuthorPath(commentId)).data.publicId == request.resource.data.authorPublicId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && consumesCommentQuota(request.auth.uid, videoId, commentId);
        allow update: if isGoogleUser() && (
          (resource.data.status == 'published'
            && isCommentAuthor(commentId, resource.data)
            && hasValidComment(request.resource.data, commentId)
            && request.resource.data.authorPublicId == resource.data.authorPublicId
            && request.resource.data.authorName == resource.data.authorName
            && request.resource.data.authorGroupIds == resource.data.authorGroupIds
            && request.resource.data.get('authorRank', null) == resource.data.get('authorRank', null)
            && request.resource.data.get('anonymous', false) == resource.data.get('anonymous', false)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text', 'videoTimeMs', 'rating', 'color', 'size', 'durationMs',
              'mode', 'x', 'y', 'visibility', 'anonymous', 'clientRequestId', 'updatedAt'
            ]))
          ||
          (resource.data.status == 'published'
            && (isReplayCommentOwner() || isCommentAuthor(commentId, resource.data))
            && request.resource.data.status == 'deleted'
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          ||
          (resource.data.status == 'published'
            && resource.data.keys().hasAny(['authorUid'])
            && (isReplayCommentOwner() || isLegacyCommentAuthor(resource.data))
            && !request.resource.data.keys().hasAny(['authorUid'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorUid'])
            && existsAfter(commentAuthorPath(commentId))
            && getAfter(commentAuthorPath(commentId)).data.uid == resource.data.authorUid
            && getAfter(commentAuthorPath(commentId)).data.publicId == resource.data.authorPublicId)
        );
        allow delete: if false;
      }
    }

  }
}
