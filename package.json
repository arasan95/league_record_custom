{
  "name": "league_record_custom",
  "version": "1.2.9",
  "description": "LeagueRecord Electron build",
  "author": "arasan95",
  "copyright": "Copyright (c) arasan95",
  "private": true,
  "type": "module",
  "main": "electron/bootstrap.mjs",
  "files": [
    "src",
    "index.html",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "scripts": {
    "dev": "bun run --watch --port 1420 src/index.html",
    "electron:dev": "node scripts/dev-electron.cjs --watch-main",
    "electron:dev:watch": "node scripts/dev-electron.cjs --watch-main",
    "electron:start": "bun run build && node scripts/start-electron.cjs",
    "electron:build": "bun run build && node scripts/build-electron.cjs nsis",
    "electron:build:portable": "bun run build && node scripts/build-electron.cjs portable",
    "logs:path": "node scripts/print-latest-log.cjs",
    "logs:tail": "node scripts/tail-latest-log.cjs",
    "logs:analyze": "node scripts/analyze-logs.cjs",
    "dev:safe": "powershell -ExecutionPolicy Bypass -File dev-safe.ps1",
    "build": "rm -rf dist && bun build --minify --target browser --outdir dist src/index.html",
    "preview": "bun dist/index.html",
    "check:responsibility": "node ci/check-responsibility-coverage.mjs",
    "test:security:metadata": "bun test tests/replay_share_security.test.ts tests/firestore_retention_privacy.test.ts",
    "test:security:rules": "firebase emulators:exec --only firestore --project demo-leaguerecord \"bun test --timeout 30000 tests/firestore.rules.test.ts tests/firestore_retention.test.ts\"",
    "test:security": "bun run test:security:metadata && bun run test:security:rules",
    "db:prune": "bun scripts/prune-firestore-retention.ts",
    "test:youtube-defaults": "bun test tests/youtube_upload_defaults.test.ts",
    "test:youtube-oauth": "bun test tests/youtube_oauth_desktop_client.test.ts",
    "backend:replay:dev": "firebase emulators:exec --only firestore --project leaguerecord \"bun backend/replay-share-server.ts\"",
    "diag:tooltip": "python tools/tooltip-diagnostics/run_tooltip_diagnostics.py",
    "diag:tooltip:ja": "python tools/tooltip-diagnostics/run_tooltip_diagnostics.py --locales ja_JP"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@fffffffxxxxxxx/league_record_types": "file:league_record_types/",
    "@fffffffxxxxxxx/videojs-markers": "^1.2.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@xmldom/xmldom": "^0.8.13",
    "electron-updater": "^6.8.9",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "sql.js": "^1.14.1",
    "video.js": "^8.23.4",
    "videojs-youtube": "^3.0.1",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tauri-apps/cli": "^2.10.0",
    "@types/bun": "^1.3.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "firebase-tools": "^15.24.0",
    "oxlint": "^1.38.0"
  },
  "build": {
    "appId": "com.leaguerecord.custom.electron",
    "productName": "LeagueRecord Electron",
    "protocols": [
      {
        "name": "LeagueRecord Replay Link",
        "schemes": ["leaguerecord"]
      }
    ],
    "executableName": "LeagueRecordElectron",
    "artifactName": "LeagueRecordElectron-Setup-${version}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "afterPack": "scripts/after-pack-electron.cjs",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/youtube/local-config.cjs",
      "!electron/youtube/local-client-id.txt",
      "!electron/youtube/local-client-secret.txt",
      "package.json",
      "app-icon.png",
      "src/assets/ranked-emblem/**/*",
      "src/assets/icon/LoL.png",
      "src/css/BeaufortW01-Bold.ttf",
      "node_modules/sql.js/**/*",
      "node_modules/ws/**/*"
    ],
    "extraResources": [
      {
        "from": "src-tauri/devtools/target/release/rebuild_tooltip_cache.exe",
        "to": "devtools/rebuild_tooltip_cache.exe"
      }
    ],
    "win": {
      "icon": "app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arasan95",
        "repo": "league_record_custom",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "include": "build/installer.nsh",
        "oneClick": false,
        "perMachine": false,
        "installerLanguages": [
          "en_US",
          "ja_JP"
        ],
        "displayLanguageSelector": false,
        "allowToChangeInstallationDirectory": false,
      "differentialPackage": true,
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
